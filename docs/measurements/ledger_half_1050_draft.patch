 HOLE_WALL_MAX_SP = 5.0
 
 
+# 덧줄 지나는 빈 머리(§1-50 초안) — 구멍 중심이 가린 덩어리 중심에서 이 안(sp). 근거는 사용 자리 주석
+LEDGER_HOLLOW_CENTER_SP = 0.15
+
+
 @dataclass
 class Notehead:
